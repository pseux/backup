{
	"name": "pseux/backup",
	"description": "Laravel package to backup database to AWS S3",
	"type": "library",
	"keywords": ["laravel", "database", "backup"],
	"license": "MIT",
	"authors": [
		{
			"name": "Oliver Svenson",
			"email": "olly@pseux.com"
		}
	],
	"require": {
		"php": "^8.1",
		"aws/aws-sdk-php": "^3.281",
		"illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/filesystem": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/process": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
		"league/flysystem-aws-s3-v3": "^3.0"
	},
	"extra": {
		"laravel": {
			"providers": [
				"Pseux\\Backup\\BackupServiceProvider"
			]
		}
	},
	"autoload": {
		"psr-4": {
			"Pseux\\Backup\\": "src"
		}
	}
}
